/* foamExternalSolvers - AmgX4Foam
 *
 * AmgX:  AMGX_INC / AMGX_LIB (SPUMA: derived from AMGX_ARCH_PATH by
 *        etc/config.sh/amgx; otherwise set them in the environment)
 *
 * CUDA runtime:
 *   nvc++ (WM_COMPILER=Nvidia*) - the -cuda language mode provides the
 *        runtime headers and library; the bundled wmake/ rules add
 *        -gpu=ccNN and the nvcc rule for .cu sources when have_cuda is set
 *   clang / AdaptiveCpp (SPUMA Sycl builds) - the toolkit is located via
 *        CUDA_PATH_SHORT (Windows) or CUDA_HOME / CUDA_PATH (Linux); with
 *        neither set the compiler's default search paths and -lcudart apply
 */

sinclude $(GENERAL_RULES)/module-path-user

/* Failsafe - default to user location */
ifeq (,$(strip $(FOAM_MODULE_LIBBIN)))
    FOAM_MODULE_LIBBIN = $(FOAM_USER_LIBBIN)
endif

/* MPI: native Windows builds link the dummy Pstream (no MPI communicators),
 * AMGX4FOAM_NO_MPI compiles those paths out (parallel runs then FatalError) */
ifneq (,$(findstring indows,$(WM_OSTYPE)))
    AMGX_MPI_FLAGS = -DAMGX4FOAM_NO_MPI
else
    sinclude $(GENERAL_RULES)/mplib$(WM_MPLIB)
    sinclude $(RULES)/mplib$(WM_MPLIB)
    AMGX_MPI_FLAGS = $(PFLAGS) $(PINC) -I$(LIB_SRC)/Pstream/mpi
endif

ifneq (,$(strip $(AMGX_INC)))
    AMGX_INC_FLAGS = -I$(AMGX_INC)
endif

ifneq (,$(findstring Nvidia,$(WM_COMPILER)))

    CC += -cuda
    AMGX_CUDA_LIBS = -fopenmp

    WMAKE_LOCAL = $(MAKE_DIR)/../../wmake
    include $(WMAKE_LOCAL)/c++

else

    ifneq (,$(strip $(CUDA_PATH_SHORT)))
        AMGX_CUDA_HOME = $(CUDA_PATH_SHORT)
    else ifneq (,$(strip $(CUDA_HOME)))
        AMGX_CUDA_HOME = $(CUDA_HOME)
    else ifneq (,$(strip $(CUDA_PATH)))
        AMGX_CUDA_HOME = $(CUDA_PATH)
    endif

    ifneq (,$(strip $(AMGX_CUDA_HOME)))
        AMGX_CUDA_INC = -I$(AMGX_CUDA_HOME)/include
        ifneq (,$(findstring indows,$(WM_OSTYPE)))
            AMGX_CUDA_LIBS = -L$(AMGX_CUDA_HOME)/lib/x64 -lcudart
        else
            AMGX_CUDA_LIBS = -L$(AMGX_CUDA_HOME)/lib64 -lcudart
        endif
    else
        AMGX_CUDA_LIBS = -lcudart
    endif

endif

EXE_INC = \
    $(AMGX_MPI_FLAGS) \
    -I$(LIB_SRC)/finiteVolume/lnInclude \
    -I$(LIB_SRC)/meshTools/lnInclude \
    -I. \
    -IcsrMatrix \
    -Iutility \
    -IAmgX4Foam \
    $(AMGX_INC_FLAGS) \
    $(AMGX_CUDA_INC)

LIB_LIBS = \
    -lfiniteVolume \
    -lmeshTools \
    -L$(AMGX_LIB) -lamgxsh \
    $(AMGX_CUDA_LIBS)
