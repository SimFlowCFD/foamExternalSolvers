#!/bin/sh
cd "${0%/*}" || exit                            # Run from this directory
targetType=libso
. "${WM_PROJECT_DIR:?}"/wmake/scripts/AllwmakeParseArguments

#------------------------------------------------------------------------------

moduleName="foamExternalSolvers (AmgX4Foam)"

case "$FOAM_MODULE_PREFIX" in
(false | none)
    echo "Compilation of $moduleName is disabled (prefix=${FOAM_MODULE_PREFIX})"
    exit 0
    ;;
esac

# Source the AmgX configuration (honors a pre-set AMGX_ARCH_PATH,
# always derives AMGX_INC/AMGX_LIB and CUDA_PATH_SHORT)
if [ -f "$WM_PROJECT_DIR/etc/config.sh/amgx" ]
then
    . "$WM_PROJECT_DIR/etc/config.sh/amgx"
fi

if [ -z "$AMGX_ARCH_PATH" ] || [ ! -d "$AMGX_ARCH_PATH/include" ]
then
    echo "Skipping $moduleName (no AmgX found: AMGX_ARCH_PATH unset or invalid)"
    echo "    Set AMGX_ARCH_PATH to an AmgX install prefix (include/ lib/)"
    exit 0
fi

case "$WM_OSTYPE" in
(*[Ww]indows*)
    if [ -z "$CUDA_PATH_SHORT" ]
    then
        echo "Skipping $moduleName (CUDA toolkit not found: CUDA_PATH/CUDA_PATH_SHORT unset)"
        exit 0
    fi
    ;;
esac

echo "Building $moduleName (AmgX: $AMGX_ARCH_PATH)"

# Assemble Make/files: CPU CSR conversion always; CUDA executors when
# have_cuda is enabled (requires a clang able to compile CUB, see
# doc/windows-sycl-cuda notes: LLVM 20 + -U__ELF__ on Windows).
(
    cd src/Make || exit
    if [ "$have_cuda" = true ]
    then
        cat filesCuda filesIn > files
    else
        cat filesIn > files
    fi
)

(cd src && wmakeLnInclude -update .)
(cd src && wmake $targetType)

#------------------------------------------------------------------------------
